---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section class="mx-auto flex max-w-3xl flex-col gap-6 px-6 py-16">
    <header class="flex flex-col gap-3">
      <h1 class="text-4xl font-black text-secondary md:text-6xl">
        Contáctanos
      </h1>
      <p class="text-lg text-secondary-first/80">
        ¿Tienes una consulta, quieres colaborar con la asociación o quieres
        tocar con nosotros? Escríbenos.
      </p>
    </header>

    <div class="grid gap-6 md:grid-cols-2">
      <article class="rounded-2xl border border-primary bg-secondary-first/40 p-6 shadow-lg">
        <h2 class="text-xl font-bold text-secondary">Datos de contacto</h2>
        <ul class="mt-3 flex flex-col gap-2 text-secondary-first/80">
          <li>Av. de Murcia, 29</li>
          <li>30520 Jumilla, Murcia</li>
          <li>Teléfono: 660 822 539</li>
          <li>
            <a
              class="underline hover:text-primary"
              href="mailto:ajam@ejemplo.com"
            >
              ajam@ejemplo.com
            </a>
          </li>
        </ul>
      </article>

      <article class="rounded-2xl border border-primary bg-secondary-first/40 p-6 shadow-lg">
        <h2 class="text-xl font-bold text-secondary">Síguenos</h2>
        <p class="mt-3 text-secondary-first/80">
          Encuentra todas nuestras novedades en redes sociales y suscríbete a la
          newsletter de la banda.
        </p>
      </article>
    </div>

    <form class="flex flex-col gap-4 rounded-2xl border border-primary bg-secondary-first/40 p-6 shadow-lg">
      <h2 class="text-xl font-bold text-secondary">Envíanos un mensaje</h2>
      <label class="flex flex-col gap-1 text-secondary-first/80">
        Nombre
        <input
          type="text"
          name="nombre"
          required
          class="rounded-xl border border-primary bg-secondary-first px-4 py-2 text-secondary outline-none focus:border-secondary"
        />
      </label>
      <label class="flex flex-col gap-1 text-secondary-first/80">
        Email
        <input
          type="email"
          name="email"
          required
          class="rounded-xl border border-primary bg-secondary-first px-4 py-2 text-secondary outline-none focus:border-secondary"
        />
      </label>
      <label class="flex flex-col gap-1 text-secondary-first/80">
        Mensaje
        <textarea
          name="mensaje"
          rows="5"
          required
          class="rounded-xl border border-primary bg-secondary-first px-4 py-2 text-secondary outline-none focus:border-secondary"
        ></textarea>
      </label>
      <button
        type="submit"
        class="w-fit cursor-pointer rounded-xl bg-primary px-6 py-3 font-semibold text-secondary transition hover:bg-primary-first"
      >
        Enviar mensaje
      </button>
    </form>
  </section>
</Layout>
