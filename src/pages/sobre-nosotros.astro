import JesusPereniguezAlbadalejo from '../assets/images/webp/JesusPereniguezAlbadalejo.jpg'
import TitleAndSubtitle from '../components/TitleAndSubtitle.astro'
---

<Layout>
  <div class="mt-16 w-full h-full flex flex-col gap-16 justify-center items-center">
    <TitleAndSubtitle
      title="Sobre nosotros"
      subtitle="Información variada sobre nuestros principales integrantes en la familia"
    />
    <div class="flex w-full flex-wrap items-center justify-center gap-10">
      <Card
        title="Ángel Hernández Azorín"
        subtitle="Director de la banda titular"
        description="Lorem ipsum dolor sit amet consectetur adipisicing elit...Lorem ipsum dolor sit amet consectetur adipisicing elit...Lorem ipsum dolor sit amet consectetur adipisicing elit...Lorem ipsum dolor sit amet consectetur adipisicing elit...Lorem ipsum dolor sit amet consectetur adipisicing elit..."
        image={AngelHernandezAzorin}
        socials={[
          { type: 'instagram', href: 'https://instagram.com/...' },
          { type: 'youtube', href: 'https://youtube.com/...' },
          { type: 'x', href: 'https://x.com/...' },
        ]}
      />
      <Card
        title="Jesús Pereñíguez Albadajelo"
        subtitle="Director de la banda juvenil"
        description="Lorem ipsum dolor sit amet consectetur adipisicing elit...Lorem ipsum dolor sit amet consectetur adipisicing elit...Lorem ipsum dolor sit amet consectetur adipisicing elit...Lorem ipsum dolor sit amet consectetur adipisicing elit...Lorem ipsum dolor sit amet consectetur adipisicing elit..."
