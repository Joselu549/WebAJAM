---
---

<div class="flex w-full max-w-5xl flex-col gap-6">
  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    <div class="min-w-0 rounded-2xl border border-primary/30 bg-white/70 p-6 shadow-md backdrop-blur-sm sm:p-8">
      <h2 class="text-xl font-bold text-secondary">Datos de contacto</h2>
      <ul class="mt-3 flex flex-col gap-2 text-secondary-first/80">
        <li>Av. de Murcia, 29</li>
        <li>30520 Jumilla, Murcia</li>
        <li>Teléfono: 660 822 539</li>
        <li>
          <a
            class="wrap-break-word underline hover:text-primary"
            href="mailto:ajambanda@ajambanda.es"
          >
            ajambanda@ajambanda.es
          </a>
        </li>
      </ul>
    </div>

    <div class="min-w-0 rounded-2xl border border-primary/30 bg-white/70 p-6 shadow-md backdrop-blur-sm sm:p-8">
      <h2 class="text-xl font-bold text-secondary">Síguenos</h2>
      <p class="mt-3 text-secondary-first/80">
        Encuentra todas nuestras novedades en redes sociales y suscríbete a la newsletter de la
        banda.
      </p>
    </div>
  </div>
  <form
    data-mailto-from
    class="flex w-full flex-col gap-6 rounded-2xl border border-primary/30 bg-white/70 p-6 shadow-md backdrop-blur-sm sm:p-8"
  >
    <div class="border-b-2 border-primary pb-3">
      <h2 class="text-2xl font-extrabold text-secondary">Envíanos un mensaje</h2>
      <p class="mt-2 text-sm text-secondary-first/70">
        Rellena el formulario y nos pondremos en contacto contigo.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <label
        for="nombre"
        class="flex min-w-0 flex-col gap-2 text-xs font-semibold tracking-widest text-secondary-first uppercase"
      >
        Nombre
        <input
          id="nombre"
          type="text"
          name="nombre"
          required
          autocomplete="name"
          placeholder="Tu nombre"
          class="w-full rounded-xl border border-primary/30 bg-ninth px-4 py-3 text-base text-secondary transition-colors outline-none placeholder:text-secondary-first/60 focus:border-secondary focus:outline-2 focus:outline-offset-2 focus:outline-primary"
        />
      </label>
    </div>

    <label
      for="mensaje"
      class="flex min-w-0 flex-col gap-2 text-xs font-semibold tracking-widest text-secondary-first uppercase"
    >
      Mensaje
      <textarea
        id="mensaje"
        name="mensaje"
        rows="6"
        required
        placeholder="Cuéntanos en qué podemos ayudarte…"
        class="min-h-36 w-full resize-y rounded-xl border border-primary/30 bg-ninth px-4 py-3 text-base leading-relaxed text-secondary transition-colors outline-none placeholder:text-secondary-first/60 focus:border-secondary focus:outline-2 focus:outline-offset-2 focus:outline-primary"
      ></textarea>
    </label>

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <button
        type="submit"
        class="w-full cursor-pointer rounded-xl bg-primary px-6 py-3 font-semibold text-secondary shadow-sm transition duration-200 hover:bg-primary-first hover:shadow-md active:translate-y-px focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary sm:w-fit"
      >
        Enviar mensaje
      </button>
      <p class="text-xs tracking-wide text-secondary-first/60 uppercase">
        Todos los campos son obligatorios
      </p>
    </div>
  </form>
</div>

<script>
  document.addEventListener('submit', (event) => {
    const form = event.target

    if (!(form instanceof HTMLFormElement) || !form.matches('[data-mailto-from]')) return

    event.preventDefault()

    const formData = new FormData(form)
    const name = formData.get('nombre')?.toString() ?? ''
    const mensaje = formData.get('mensaje')?.toString() ?? ''
    const subject = encodeURIComponent(`Contacto desde la web: ${name}`)
    const body = encodeURIComponent(`${mensaje}\n\n
      ================================================================================
      Enviado desde la web de la Asociación Jumillana de Amigos de la Música
      ================================================================================
    `)

    window.location.href = `mailto:ajambanda@ajambanda.es?subject=${subject}&body=${body}`
  })
</script>
