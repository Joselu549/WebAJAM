---
import facebook from "../assets/images/icons/facebook.svg";
import instagram from "../assets/images/icons/instagram.svg";
import youtube from "../assets/images/icons/youtube.svg";
import "../styles/global.css";
---

<footer class="flex h-fit w-full flex-col items-center justify-center gap-5 bg-secondary px-4 py-5 text-center text-ninth sm:px-6">
  <div class="flex flex-col items-center justify-center gap-1">
    <p class="font-black">Asociación Jumillana Amigos de la Música</p>
    <p>Av. de Murcia, 29, 30520 Jumilla, Murcia</p>
    <p>Teléfono: 660 822 539</p>
  </div>
  <hr class="m-5 w-1/2 max-w-xs border-ninth" />
  <div class="flex align-center justify-center gap-5">
    <a href="https://www.facebook.com/ajambanda/" target="_blank">
      <img src={facebook.src} width="35" height="35" alt="Facebook" />
    </a>
    <a href="https://www.instagram.com/ajambanda/" target="_blank">
      <img src={instagram.src} width="35" height="35" alt="Instagram" />
    </a>
    <a href="https://www.youtube.com/@ajambanda" target="_blank">
      <img src={youtube.src} width="35" height="35" alt="YouTube" />
    </a>
  </div>
  <span class="text-xs sm:text-sm">
    &copy; 2025 Asociación Jumillana Amigos de la Música. Todos los derechos
    reservados.
  </span>
</footer>
